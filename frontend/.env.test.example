# QA harness configuration — copy to .env.test (git-ignored) and adjust.
# No real secrets belong in this example file.

QA_PROJECT=beautyfolio
QA_BASE_URL=http://localhost:8081
QA_ENVIRONMENT=local

# Provider credentials — Node-only, read by tests/helpers/providers/
# supabase-provider.ts for opt-in `npm run test:provider` checks. Same
# variable names the app's own server-side client already uses. Never
# imported into Playwright specs / browser context. Leave unset to run the
# rest of the QA suite (unit/security/safety/e2e/test:qa) with zero
# service-role secrets — those tests skip gracefully instead of failing.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# QA project's publishable (anon) key — safe to expose client-side by
# Supabase's own design (same trust level as the app's own
# VITE_SUPABASE_PUBLISHABLE_KEY in .env), unlike SUPABASE_SERVICE_ROLE_KEY
# above. Used by the isolated QA Playwright browser runtime
# (playwright.qa.config.ts) to point the app's client-side Supabase client
# at the QA project instead of production.
QA_SUPABASE_PUBLISHABLE_KEY=

# Destructive-test safety gate (tests/helpers/safety-gate.ts). ALL of these
# must independently hold before any future destructive QA operation is
# allowed to run against a backend. Fail-closed: any missing/mismatched
# value denies. QA_ALLOW_WRITES defaults to false — never flip this against
# the real BeautyFolio backend (ref ivbujlyilzmlublqzalu), which is
# permanently denylisted in tests/projects/beautyfolio/project.ts regardless
# of any value set here.
QA_ALLOW_WRITES=false
QA_EXPECTED_PROJECT_REF=
QA_RECORD_PREFIX=QA_E2E_
QA_PROFILE_SLUG_PREFIX=qa-test-

# Persistent QA fixture identities (QA-1D Step 3B). Created once via the
# guarded identity provisioner (tests/helpers/providers/qa-identity-
# provisioner.ts), never manually. Passwords are generated locally with a
# cryptographically secure RNG and must never be committed with real
# values — leave empty here.
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=

QA_PRO_A_EMAIL=
QA_PRO_A_PASSWORD=

QA_PRO_B_EMAIL=
QA_PRO_B_PASSWORD=

# Lead-arrival email notification (names only — never set a real value
# here or in QA). Read server-side by src/lib/email/transport.ts. Left
# unset intentionally in every QA/local environment so the mock transport
# is always selected — no real email is ever sent by tests. Production
# values belong only in the deploy platform's own env config, never in a
# tracked file, and are configured in a later launch phase (domain/DNS/
# Resend verification still pending).
RESEND_API_KEY=
LEAD_NOTIFICATION_FROM_EMAIL=
