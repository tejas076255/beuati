# App runtime configuration template — copy to .env (git-ignored) and fill
# in real values from your Supabase project settings / deploy platform.
# No real secrets belong in this example file.

# ---- PUBLIC CONFIG — safe to expose client-side by Supabase's own design
# (VITE_-prefixed vars are inlined into the browser bundle at build time).
# Same values, one server-only pair (no VITE_ prefix) and one client-bundle
# pair, matching src/integrations/supabase/client.server.ts /
# src/integrations/supabase/client.ts.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Canonical site origin used for absolute URLs/SEO (src/lib/site-url.ts).
VITE_SITE_URL=

# ---- SERVER ONLY — FastAPI backend URL ----
# The Python/FastAPI backend this frontend's server functions proxy to
# (src/lib/api-client.server.ts). Server-only; NEVER prefix with VITE_.
FASTAPI_URL=

# ---- SERVER SECRET — server-only, NEVER prefix with VITE_ (that would
# bundle it into the browser). Bypasses RLS; used only by
# src/integrations/supabase/client.server.ts for trusted server-side reads.
# Required for local admin-workspace/server-fn testing; not required for
# the app to build or run the public pages.
SUPABASE_SERVICE_ROLE_KEY=

# ---- SERVER SECRET — lead-arrival email notification (src/lib/email/
# transport.ts). Both unset by default: the app falls back to a safe mock
# transport that sends nothing externally. Production values (domain
# verification, real API key, real sender address) are a separate,
# later launch task — never set here in this template, and never commit
# real values to any tracked file.
RESEND_API_KEY=
LEAD_NOTIFICATION_FROM_EMAIL=
