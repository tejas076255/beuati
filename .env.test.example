# QA harness configuration — copy to .env.test (git-ignored) and adjust.
# No real secrets belong in this example file.

QA_PROJECT=beautyfolio
QA_BASE_URL=http://localhost:8080
QA_ENVIRONMENT=local

# Provider credentials — Node-only, read by tests/helpers/providers/
# supabase-provider.ts for opt-in `npm run test:provider` checks. Same
# variable names the app's own server-side client already uses. Never
# imported into Playwright specs / browser context. Leave unset to run the
# rest of the QA suite (unit/security/safety/e2e/test:qa) with zero
# service-role secrets — those tests skip gracefully instead of failing.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Destructive-test safety gate (tests/helpers/safety-gate.ts). ALL of these
# must independently hold before any future destructive QA operation is
# allowed to run against a backend. Fail-closed: any missing/mismatched
# value denies. QA_ALLOW_WRITES defaults to false — never flip this against
# the real BeautyFolio backend (ref ivbujlyilzmlublqzalu), which is
# permanently denylisted in tests/projects/beautyfolio/project.ts regardless
# of any value set here.
QA_ALLOW_WRITES=false
QA_EXPECTED_PROJECT_REF=
QA_RECORD_PREFIX=QA_E2E_
QA_PROFILE_SLUG_PREFIX=qa-test-

# Reserved for later phases (dedicated QA identities) — not required yet and
# must never be committed with real values.
# QA_ADMIN_EMAIL=
# QA_PRO_A_EMAIL=
# QA_PRO_B_EMAIL=
